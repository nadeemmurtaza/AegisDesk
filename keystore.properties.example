# Release signing configuration — COPY THIS FILE TO keystore.properties (gitignored)
# and fill in real values. apps/android/build.gradle.kts reads keystore.properties
# from the repository root; while the file is absent, `assembleRelease` builds
# debug-signed, and CI builds debug only — so nothing blocks development.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore keystore.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias key0 -storepass <store-password> -keypass <key-password>
#
# Never commit keystore.properties or the .jks/.keystore files (gitignored).

storeFile=keystore.jks
storePassword=change-me
keyAlias=key0
keyPassword=change-me
